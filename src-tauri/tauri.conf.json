{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ugly Avatar",
  "version": "0.1.0",
  "identifier": "com.txstc55.uglyavatar",
  "build": {
    "beforeDevCommand": "npm run serve",
    "beforeBuildCommand": "npm run build:tauri",
    "devUrl": "http://localhost:8080",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ugly Avatar",
        "width": 620,
        "height": 700,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Xuan Tang",
    "copyright": "Copyright (c) 2026 Xuan Tang",
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      }
    }
  }
}
